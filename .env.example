# LinkedIn OAuth application
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# The application requests the minimum scopes required by the current tools:
# openid profile w_member_social

# Runtime credentials (keep these outside Git)
# LINKEDIN_ACCESS_TOKEN is read from access_token.txt
# LINKEDIN_AUTHOR_URN is read from person_urn.txt
